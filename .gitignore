# ===== Datos (NO versionar el dataset AI4Mars) =====
# Se ignora el CONTENIDO de data/ pero se conserva la carpeta vía .gitkeep.
# (Ignorar "data/" entero impediría re-incluir cualquier archivo dentro.)
/data/*
!/data/.gitkeep

# Copia del dataset AI4Mars dentro del proyecto (~16 GB). NUNCA versionar.
/ai4mars-dataset-merged-0.6/
ai4mars-dataset-*/

# Imágenes de prueba de Rekognition (copiadas del dataset) y sus salidas.
outputs/rekognition_test/

# Pesos de modelos (FastSAM/YOLO) y salidas de ultralytics — se descargan, no se versionan.
*.pt
runs/

# Conservar metadatos pequeños si se desea versionarlos explícitamente:
# !/data/metadata.csv

# ===== Outputs grandes / generados =====
# Se ignora el contenido de figures/ salvo las figuras en formato tesis, que se citan
# en docs/ y por tanto deben estar en el repositorio. (Ignorar el directorio entero
# impediría re-incluir cualquier archivo de su interior.)
outputs/figures/*
!outputs/figures/tesis/
outputs/*.csv
!outputs/.gitkeep
# results.csv es el entregable principal (E4): se versiona (1 MB).
!outputs/results.csv
# Resultados pequeños que respaldan figuras del documento.
!outputs/cobertura_modelo_vs_humano.csv

# ===== Entorno conda exportado con builds locales =====
environment.lock.yml

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# ===== Entornos virtuales =====
.venv/
venv/
env/
ENV/

# ===== Jupyter =====
.jupyter/
*.ipynb_checkpoints

# ===== Sistema operativo =====
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ===== Editores / IDE =====
.idea/
.vscode/
*.swp
*.swo
*~

# ===== Credenciales / config local =====
.env
.env.local

# ===== Guía local del proyecto (no se publica) =====
CLAUDE.md

# ===== Kit de validación manual =====
# Las imágenes se regeneran con scripts/make_validation_kit.py; los CSV sí se versionan
# porque plantilla.csv contiene las respuestas humanas de la validación.
outputs/validacion_manual/imagenes/
outputs/validacion_manual_v2/imagenes/

# ===== Salidas del sistema de alertas =====
# El panel HTML y los resúmenes se versionan (son el entregable consultable);
# las tablas completas se regeneran con los scripts.
!outputs/panel_ai4mars.html
!outputs/alertas_catalogo.csv
!outputs/alertas_resumen.json
!outputs/geologia_m2020_resumen.json

# Figuras de vetas: se regeneran con scripts/make_vein_figures.py
outputs/figures/vetas/

# ===== Artefactos de compilación LaTeX (tesis/) =====
# El documento se compila en Overleaf o localmente; solo se versiona la fuente.
tesis/*.aux
tesis/*.log
tesis/*.out
tesis/*.toc
tesis/*.lof
tesis/*.lot
tesis/*.bcf
tesis/*.bbl
tesis/*.blg
tesis/*.run.xml
tesis/*.fls
tesis/*.fdb_latexmk
tesis/*.synctex.gz
tesis/main.pdf

# PDF de revisión local (el entregable se compila en Overleaf)
tesis_revision.pdf

# ===== Guion de defensa =====
# Se versiona la fuente; el PDF se regenera con: tectonic -k defensa/guion_defensa.tex
defensa/*.aux
defensa/*.log
defensa/*.out
defensa/*.toc
defensa/guion_defensa.pdf
